# Segredos do monitoramento (etapa 3.5).
# TEMPLATE versionado: o secrets.yaml real é gerado por infra/monitoring/gerar-secrets.sh e fica no .gitignore.
---
# Login do Grafana (o chart lê via grafana.admin.existingSecret)
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: tipsbank-monitoring
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  admin-user: admin
  admin-password: "__GRAFANA_PASS__"
---
# Basic Auth do Ingress do Prometheus e do Alertmanager (formato htpasswd: usuario:hash SHA-512 crypt)
apiVersion: v1
kind: Secret
metadata:
  name: monitoring-basic-auth
  namespace: tipsbank-monitoring
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  auth: "admin:__HASH__"
