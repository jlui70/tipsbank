{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {"format": "{\"ts\":\"%(asctime)s\",\"level\":\"%(levelname)s\",\"service\":\"api-transacoes\",\"logger\":\"%(name)s\",\"msg\":\"%(message)s\"}"},
    "access": {"()": "uvicorn.logging.AccessFormatter", "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s", "use_colors": false}
  },
  "handlers": {
    "console": {"class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stdout"},
    "file": {"class": "logging.handlers.RotatingFileHandler", "formatter": "json", "filename": "/var/log/app/app.log", "maxBytes": 10485760, "backupCount": 1},
    "access": {"class": "logging.StreamHandler", "formatter": "access", "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn.error": {"level": "INFO", "handlers": ["console", "file"], "propagate": false},
    "uvicorn.access": {"level": "INFO", "handlers": ["access"], "propagate": false},
    "httpx": {"level": "WARNING"}
  },
  "root": {"level": "INFO", "handlers": ["console", "file"]}
}
