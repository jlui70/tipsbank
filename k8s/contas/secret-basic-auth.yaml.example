# Basic Auth da rota api.tipsbank.local/contas/admin (etapa 2.2).
# TEMPLATE versionado: o secret-basic-auth.yaml real é gerado por k8s/contas/gerar-basic-auth.sh
# e fica no .gitignore. O Ingress NGINX lê a chave "auth" no formato htpasswd (usuario:hash).
# O hash é SHA-512 crypt ($6$...), gerado com openssl passwd -6: a senha em texto não vai para o cluster.
apiVersion: v1
kind: Secret
metadata:
  name: contas-admin-basic-auth
  namespace: tipsbank-contas
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  auth: "__USUARIO__:__HASH__"
