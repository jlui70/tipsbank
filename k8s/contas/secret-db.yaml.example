# Credenciais do Postgres (Secret Opaque).
# TEMPLATE versionado: o secret-db.yaml real é gerado por k8s/gerar-secrets.sh e fica no .gitignore.
# stringData = texto puro no manifest; o API server grava em base64 em .data.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: tipsbank-contas
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  POSTGRES_USER: tipsbank
  POSTGRES_PASSWORD: "__POSTGRES_PASSWORD__"
  POSTGRES_DB: tipsbank
  REPLICATION_PASSWORD: "__REPLICATION_PASSWORD__"   # 3.3: usuário replicator (postgres-replica)
---
# URL de conexão da api-contas (contém a senha -> Secret, não ConfigMap)
apiVersion: v1
kind: Secret
metadata:
  name: contas-db
  namespace: tipsbank-contas
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  DB_URL: "postgresql+psycopg://tipsbank:__POSTGRES_PASSWORD__@postgres-primary.tipsbank-contas.svc.cluster.local:5432/tipsbank"
