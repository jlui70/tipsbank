# Credenciais do Postgres (Secret Opaque).
# TEMPLATE versionado: o secret-db.yaml real é gerado por k8s/gerar-secrets.sh e fica no .gitignore.
# stringData = texto puro no manifest; o API server grava em base64 em .data.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: tipsbank-contas
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  POSTGRES_USER: tipsbank
  POSTGRES_PASSWORD: "__POSTGRES_PASSWORD__"
  POSTGRES_DB: tipsbank
  REPLICATION_PASSWORD: "__REPLICATION_PASSWORD__"   # 3.3: usuário replicator (postgres-replica)
  # 4.4: usuários de aplicação (sql/roles-app.sh). O POSTGRES_USER acima é o
  # SUPERUSUÁRIO: só para o DBA, via kubectl exec (rede rejeitada no pg_hba).
  CONTAS_DB_PASSWORD: "__CONTAS_DB_PASSWORD__"
  TRANSACOES_DB_PASSWORD: "__TRANSACOES_DB_PASSWORD__"
---
# URL de conexão da api-contas (contém a senha -> Secret, não ConfigMap).
# 4.4: usuário app_contas (só contas/movimentos, sem DDL), não o superusuário.
apiVersion: v1
kind: Secret
metadata:
  name: contas-db
  namespace: tipsbank-contas
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  DB_URL: "postgresql+psycopg://app_contas:__CONTAS_DB_PASSWORD__@postgres-primary.tipsbank-contas.svc.cluster.local:5432/tipsbank"
