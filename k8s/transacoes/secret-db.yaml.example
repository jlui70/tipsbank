# TEMPLATE versionado: o secret-db.yaml real é gerado por k8s/gerar-secrets.sh e fica no .gitignore.
# A api-transacoes também grava no Postgres (tabela transacoes).
# 4.4: usuário app_transacoes (só a tabela transacoes, sem DDL), não o superusuário.
# Secret próprio no namespace dela: Secrets não são compartilhados entre namespaces.
apiVersion: v1
kind: Secret
metadata:
  name: transacoes-db
  namespace: tipsbank-transacoes
  labels: {app.kubernetes.io/part-of: tipsbank}
type: Opaque
stringData:
  DB_URL: "postgresql+psycopg://app_transacoes:__TRANSACOES_DB_PASSWORD__@postgres-primary.tipsbank-contas.svc.cluster.local:5432/tipsbank"
