# --- Segredos: NUNCA versionar ---
# Chaves privadas, CSRs e certificados de usuarios RBAC (etapa 4.4)
*.key
*.csr
*.pem
*.crt
# Kubeconfigs gerados para os perfis RBAC e dos clusters
*.kubeconfig
kubeconfig*
evidencias/kubeconfigs/
# Chaves Cosign (a publica cosign.pub pode ir; a privada nunca)
cosign.key
# htpasswd do Basic Auth do Ingress
auth
*.htpasswd
# Variaveis de ambiente / credenciais locais
.env
.env.*
# Secrets do Postgres gerados por k8s/gerar-secrets.sh (versionar so o *.example)
k8s/**/secret-db.yaml
# Basic Auth do /contas/admin gerada por k8s/contas/gerar-basic-auth.sh (versionar so o *.example)
k8s/**/secret-basic-auth.yaml
k8s/**/.basic-auth-senha
# Segredos do monitoramento gerados por infra/monitoring/gerar-secrets.sh (versionar so o *.example)
infra/monitoring/secrets.yaml
infra/monitoring/.senhas

# --- Terraform / eksctl (se usados para EC2/EKS) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# --- Helm ---
helm/**/charts/*.tgz
*.tgz

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Editor / SO ---
.DS_Store
*.swp
*:Zone.Identifier
.vscode/
.idea/

# --- Notas pessoais (roteiro do video, nao entregavel) ---
notas-video.md

# --- Roteiros de aula (teste de docência, não entregável) ---
roteiros/
dist/
